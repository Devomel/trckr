name: Android APK

on:
  push:
  workflow_dispatch:

permissions:
  contents: write

defaults:
  run:
    working-directory: trckr-mvp

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: "17"
      - uses: gradle/actions/setup-gradle@v4
      - name: Build APK
        run: |
          chmod +x gradlew
          ./gradlew --no-daemon assembleDebug
          cp app/build/outputs/apk/debug/app-debug.apk ../trckr.apk
      - uses: actions/upload-artifact@v4
        with:
          name: trckr-apk
          path: trckr.apk
      - name: Publish to "latest" release
        uses: softprops/action-gh-release@v2
        with:
          tag_name: latest
          name: trckr latest build
          prerelease: true
          files: trckr.apk
